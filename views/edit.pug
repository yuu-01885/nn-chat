doctype html
html(lang="ja")
  head
    meta(charset="UTF-8")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
      integrity="sha256-fx038NkLY4U1TCrBDiu5FWPEa9eiZu01EiLryshJbCo="
      crossorigin="anonymous")
    link(rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.8.0/font/bootstrap-icons.css")
    link(rel="stylesheet" href="/style.css")
    title 投稿編集
  body.container.overflow-scroll(data-bs-theme=currentTheme)
    nav.navbar.fixed-top.bg-primary
      div.container-fluid
        a.navbar-brand.text-light.mx-auto(href="/posts") NNチャット
          i.bi-chat-dots-fill.ms-1
    div(style="margin-top: 100px")
    div.card.my-3.border-primary
      div.card-body
        div.d-flex.justify-content-between.align-items-center.mb-3
          h3.card-title.mb-0 投稿編集
            i.bi-pencil-square.ms-2
        form(method="post" action="/posts/edit")
          input(type="hidden" name="id" value=post.id)
          div.mb-3
            textarea(name="content" rows="5").form-control.lead #{post.content}
          div.d-flex.justify-content-between
            a(href="/posts").btn.btn-outline-secondary 戻る
              i.bi-arrow-left.ms-1

            button(type="submit").btn.btn-primary 保存
              i.bi-check-lg.ms-1

    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"
      integrity="sha256-qlPVgvl+tZTCpcxYJFdHB/m6mDe84wRr+l81VoYPTgQ="
      crossorigin="anonymous")